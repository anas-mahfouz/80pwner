#!/usr/bin/env bash
# 80PWNER launcher — by Anas Mahfouz (The80)
# Usage: ./80pwner [--version] [options]
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Prefer an installed copy (pipx/pip); fall back to the source tree for dev runs.
if ! python3 -c "import eightypwner" 2>/dev/null; then
    export PYTHONPATH="${PYTHONPATH:-}:$DIR/src"
fi

exec python3 -m eightypwner "$@"
