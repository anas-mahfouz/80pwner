/* 80PWNER — dark theme (by Anas Mahfouz (The80)) — token-substituted QSS */

QMainWindow, QDialog {
    background: ${bg};
    color: ${fg};
}

QWidget { color: ${fg}; }

/* ---- menus / toolbar ---------------------------------------------------- */
QMenuBar {
    background: ${panel};
    color: ${fg};
    border-bottom: 1px solid ${border};
}
QMenuBar::item:selected { background: ${panel_alt}; }
QMenu {
    background: ${panel};
    color: ${fg};
    border: 1px solid ${border};
    padding: 4px;
}
QMenu::item:selected { background: ${accent}; color: ${on_accent}; }
QMenu::separator { height: 1px; background: ${border}; margin: 4px 8px; }

QToolBar {
    background: ${panel};
    border-bottom: 1px solid ${border};
    padding: 3px;
    spacing: 6px;
}
QToolBar::separator { width: 1px; background: ${border}; margin: 4px; }
QToolButton:hover { color: ${accent_hover}; }

/* ---- docks --------------------------------------------------------------- */
QDockWidget { color: ${fg}; }
QDockWidget::title {
    background: ${panel_alt};
    border-bottom: 2px solid ${accent_dim};
    /* generous vertical padding: the text is laid out in the padding box, so
       title height ends up = font + 2*8 + 2 (border) — descenders and fonts
       with taller metrics (icon emoji fallbacks, DPI scaling) never clip */
    padding: 8px 10px;
}

/* ---- status bar ---------------------------------------------------------- */
QStatusBar {
    background: ${panel};
    color: ${fg};
    border-top: 1px solid ${border};
}
QStatusBar QLabel { padding: 0 6px; }

/* ---- buttons / inputs ---------------------------------------------------- */
QPushButton {
    background: ${panel_alt};
    color: ${fg};
    border: 1px solid ${border};
    border-radius: 4px;
    padding: 4px 12px;
}
QPushButton:hover { border-color: ${accent_hover}; color: ${accent_hover}; }
QPushButton:pressed, QPushButton:checked { background: ${accent_pressed}; color: ${on_accent}; }
QPushButton:disabled { color: ${dim}; border-color: ${border}; }

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QComboBox {
    background: ${panel_alt};
    color: ${fg};
    border: 1px solid ${border};
    border-radius: 4px;
    padding: 3px;
    selection-background-color: ${accent};
    selection-color: ${on_accent};
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid ${accent};
}

QScrollBar:vertical { background: ${panel}; width: 10px; }
QScrollBar::handle:vertical { background: ${border}; border-radius: 4px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: ${accent_dim}; }
QScrollBar:horizontal { background: ${panel}; height: 10px; }
QScrollBar::handle:horizontal { background: ${border}; border-radius: 4px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }

/* ---- labels / panels ----------------------------------------------------- */
QLabel { color: ${fg}; }
QLabel[role="brandAscii"] {
    color: ${accent};
    font-size: 10pt;
    background: transparent;
}
QLabel[role="brandFooter"] {
    color: ${accent};
    padding: 0 8px;
}
QLabel[role="brandFooter"]:hover { color: ${accent_hover}; }

/* Table "current row / selection" highlights in accent */
QTableView, QTreeView, QListView {
    selection-background-color: ${accent};
    selection-color: ${on_accent};
    alternate-background-color: ${panel_alt};
    gridline-color: ${border};
}
QHeaderView::section {
    background: ${panel};
    color: ${fg};
    border: none;
    border-right: 1px solid ${border};
    border-bottom: 2px solid ${accent_dim};
    padding: 4px 8px;
}

/* ---- semantic badges (checksec etc.) — NOT the accent ---------------------- */
QLabel[role="badge-ok"]    { color: ${ok};    background: ${ok_bg};    border-radius: 3px; padding: 2px 8px; font-weight: bold; }
QLabel[role="badge-warn"]  { color: ${warn};  background: ${warn_bg};  border-radius: 3px; padding: 2px 8px; font-weight: bold; }
QLabel[role="badge-error"] { color: ${on_error}; background: ${error}; border-radius: 3px; padding: 2px 8px; font-weight: bold; }
QLabel[role="badge-na"]    { color: ${na};    background: ${na_bg};    border-radius: 3px; padding: 2px 8px; }

QPlainTextEdit, QTextEdit { background: ${panel_alt}; font-family: $MONO; }

/* Tool tips */
QToolTip {
    background: ${panel_alt};
    color: ${fg};
    border: 1px solid ${accent_dim};
    padding: 3px;
}
